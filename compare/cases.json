   "v": "<b>"
  },
  "env": {
   "autoescape": true
  }
 },
 {
  "name": "autoescape off",
  "template": "{{ v }}",
  "data": {
   "v": "<b>"
  }
 },
 {
  "name": "autoescape block",
  "template": "{% autoescape true %}{{ v }}{% endautoescape %}|{% autoescape false %}{{ v }}{% endautoescape %}",
  "data": {
   "v": "<b>"
  }
 },
 {
  "name": "escape no autoescape",
